  "keyFeatures": [
    "Vendor-independent C API for controlling switching ASICs, NPUs, and software switches",
    "CRUD-based object model with attribute-based configuration for extensibility",
    "55+ API modules covering switching, routing, QoS, security, tunneling, and telemetry",
    "Extension mechanism for experimental and vendor-specific features",
    "Support for warm reboot and stateless adapter design",
    "Metadata framework for attribute validation and auto-generated RPC stubs",
    "DASH (Disaggregated APIs for SONiC Hosts) experimental extensions for cloud networking"
  ],
  "publicApiSurface": [
    "sai_api_initialize()",
    "sai_api_query()",
    "sai_api_uninitialize()",
    "sai_object_type_query()",
    "sai_switch_id_query()",
    "sai_object_type_get_availability()",
    "sai_dbg_generate_dump()",
    "sai_log_set()",
    "sai_switch_api_t (create/remove/get/set switch)",
    "sai_port_api_t (create/remove/get/set port)",
    "sai_fdb_api_t (create/remove/flush/get/set FDB entries)",
    "sai_vlan_api_t (create/remove/get/set VLANs)",
    "sai_route_api_t (create/remove/get/set routes)",
    "sai_next_hop_api_t (create/remove/get/set next hops)",
    "sai_acl_api_t (create/remove/get/set ACL tables and entries)",
    "sai_tunnel_api_t (create/remove/get/set tunnels)",
    "sai_macsec_api_t (create/remove/get/set MACsec objects)",
    "sai_tam_api_t (telemetry and monitoring)",
    "sai_counter_api_t (generic counters)"
  ]
}
